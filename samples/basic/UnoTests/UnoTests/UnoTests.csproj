<Project Sdk="Uno.Sdk/7.0.5">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>UnoTests</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.UnoTests</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>btord</ApplicationPublisher>
    <!-- Package Description -->
    <Description>UnoTests powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Dsp;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      HttpKiota;
      Serialization;
      Localization;
      Navigation;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <!--
      Marshal methods (on by default for Android Release in .NET 10) crash this test
      app at startup on the x86_64 CI emulator: SIGSEGV in libmonosgen-2.0.so while
      resolving the first managed method, "App started but could not retrieve PID".
      Turning them off is the only build switch that fixed it (AOT, apk vs aab,
      interpreter and assembly store made no difference). They only speed up
      Java-to-.NET calls, which a test app does not need.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Factos.Uno\Factos.Uno.csproj" />
    <ProjectReference
        Include="..\..\..\..\src\CodeGen\CodeGen.csproj"
        OutputItemType="Analyzer"
        ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
